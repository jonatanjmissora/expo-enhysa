{
	"cli": {
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"environment": "development"
		},
		"preview": {
			"distribution": "internal",
			"autoIncrement": true,
			"environment": "preview",
			"node": "22.19.0",
			"pnpm": "12.8.1",
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"autoIncrement": true,
			"environment": "production",
			"node": "22.19.0",
			"pnpm": "12.8.1"
		}
	}
}
