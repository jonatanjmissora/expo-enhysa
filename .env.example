# ─────────────────────────────────────────────────────────────
# App (Expo) — variables PÚBLICAS. Van al bundle: NO poner secretos.
# Solo las que empiezan con EXPO_PUBLIC_ llegan al cliente.
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# Backend — variables SECRETAS. NO van en la app.
# Se cargan en el panel del hosting (Vercel/Netlify/etc.).
# Se listan acá solo como referencia de nombres.
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_PUBLIC_KEY=
# MERCADO_PAGO_WEBHOOK_SECRET=
# API_TOKEN=
# BACKEND_BASE_URL=
# APP_DEEP_LINK=expoenhysa://pago
# MP_ENV=sandbox
